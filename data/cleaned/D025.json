    {
      "kind": "paragraph",
      "page": 1,
      "section_path": [
        "BE55",
        "Description"
      ],
      "zone": "main",
      "text": "BE55 is a high molecular weight, low melt flow rate polypropylene homopolymer. The product is available in natural colour."
    },
